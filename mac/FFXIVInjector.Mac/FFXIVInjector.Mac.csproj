<Project Sdk="Microsoft.NET.Sdk">
  <!-- macOS text/font patch tool. Builds against an unmodified upstream checkout:
       dotnet publish -p:UpstreamRoot=/path/to/ffxiv-kr-data-injector -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ffxiv-kr-mac</AssemblyName>
    <RootNamespace>FFXIVInjector.Mac</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory)../..</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpstreamTag" Value="$(UpstreamTag)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(UpstreamRoot)/FFXIVInjector.Core/FFXIVInjector.Core.csproj" />
  </ItemGroup>
</Project>
